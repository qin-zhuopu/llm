{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vertical Industry LLM Model",
  "description": "垂直业务领域大语言模型结构化数据，侧重训练过程、技术栈、数据集、评测和 API 接入",
  "type": "object",
  "required": [
    "name",
    "company",
    "domain",
    "status",
    "description",
    "capabilities",
    "references"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "模型名称",
      "minLength": 1
    },
    "name_en": {
      "type": "string",
      "description": "模型英文名称（如果主名称是中文）"
    },
    "company": {
      "type": "string",
      "description": "开发公司",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "description": "所属垂直领域",
      "enum": [
        "finance",
        "healthcare",
        "legal",
        "retail-ecommerce",
        "education",
        "automotive",
        "pharma-biotech",
        "manufacturing",
        "telecom",
        "energy",
        "government",
        "construction-realestate",
        "media-entertainment",
        "logistics-supplychain",
        "agriculture",
        "materials-science",
        "climate-environment",
        "aerospace-defense",
        "human-resources",
        "accounting-audit",
        "software-development",
        "customer-service"
      ]
    },
    "status": {
      "type": "string",
      "description": "模型状态",
      "enum": [
        "released",
        "internal",
        "research",
        "deprecated"
      ]
    },
    "release_date": {
      "type": "string",
      "description": "发布日期 (YYYY 或 YYYY-MM 或 YYYY-MM-DD)",
      "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
    },
    "website": {
      "type": "string",
      "description": "官方网站URL",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "description": "模型简介（应包含核心定位、参数量、差异化特点）",
      "minLength": 30
    },
    "parameters": {
      "type": "string",
      "description": "参数量（如 50B, 175B, 7B x MoE, 未公开）"
    },
    "architecture": {
      "type": "string",
      "description": "模型架构（如 decoder-only transformer, encoder-decoder, MoE, diffusion）"
    },
    "base_model": {
      "description": "基座模型，微调/继续训练的起点",
      "oneOf": [
        {
          "type": "string",
          "description": "单个基座模型（如 LLaMA-2-70B, GPT-4, BLOOM）"
        },
        {
          "type": "array",
          "description": "多个基座模型（merge 场景）",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "training": {
      "type": "object",
      "description": "训练过程详情",
      "properties": {
        "stages": {
          "type": "array",
          "description": "训练阶段列表（按时序排列）",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "阶段名称",
                "enum": [
                  "pre-training",
                  "continual-pre-training",
                  "sft",
                  "rlhf",
                  "dpo",
                  "rlaif",
                  "distillation",
                  "quantization",
                  "fine-tuning",
                  "post-training",
                  "other"
                ]
              },
              "description": {
                "type": "string",
                "description": "该阶段的具体说明"
              },
              "data_tokens": {
                "type": "string",
                "description": "该阶段使用的 token 数量（如 363B, 1.5T）"
              },
              "hardware": {
                "type": "string",
                "description": "训练硬件（如 512x A100 80G, 2048x H100）"
              },
              "duration": {
                "type": "string",
                "description": "训练时长（如 53 days, 2 months）"
              }
            }
          }
        },
        "total_tokens": {
          "type": "string",
          "description": "总训练 token 数"
        },
        "total_cost": {
          "type": "string",
          "description": "训练总成本估计（如 $2.7M-$10M）"
        },
        "context_length": {
          "type": "string",
          "description": "上下文窗口长度（如 4K, 32K, 128K）"
        }
      }
    },
    "tech_stack": {
      "type": "object",
      "description": "技术栈",
      "properties": {
        "framework": {
          "type": "string",
          "description": "训练框架（如 Megatron-LM, DeepSpeed, JAX/Flax, PyTorch FSDP）"
        },
        "inference": {
          "type": "string",
          "description": "推理框架（如 vLLM, TensorRT-LLM, TGI, triton）"
        },
        "techniques": {
          "type": "array",
          "description": "关键技术（如 Flash Attention, RoPE, GQA, MoE, speculative decoding）",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "description": "训练数据集列表",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "数据集名称"
          },
          "description": {
            "type": "string",
            "description": "数据集说明"
          },
          "size": {
            "type": "string",
            "description": "数据量（如 363B tokens, 10M samples, 2TB）"
          },
          "type": {
            "type": "string",
            "description": "数据集用途",
            "enum": [
              "pre-training",
              "sft",
              "rlhf",
              "evaluation",
              "other"
            ]
          }
        }
      }
    },
    "benchmarks": {
      "type": "array",
      "description": "评测结果（测试集 + 打分）",
      "items": {
        "type": "object",
        "required": [
          "name",
          "score"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "测试集/评测基准名称（如 MedQA, FinBench, MMLU, HumanEval）"
          },
          "score": {
            "description": "得分",
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "metric": {
            "type": "string",
            "description": "评测指标（如 accuracy, F1, BLEU, pass@1）"
          },
          "split": {
            "type": "string",
            "description": "数据分割（如 test, dev, 5-shot）"
          },
          "comparison": {
            "type": "string",
            "description": "与基线对比（如 vs GPT-4: 86.5% vs 87.0%）"
          }
        }
      }
    },
    "api": {
      "type": "object",
      "description": "API 接入信息",
      "properties": {
        "available": {
          "type": "boolean",
          "description": "是否提供 API"
        },
        "documentation": {
          "type": "string",
          "description": "API 文档链接",
          "format": "uri"
        },
        "endpoint": {
          "type": "string",
          "description": "API 端点地址（如 https://api.example.com/v1/chat）"
        },
        "protocol": {
          "type": "string",
          "description": "API 协议类型",
          "enum": [
            "openai-compatible",
            "rest",
            "grpc",
            "graphql",
            "websocket",
            "proprietary",
            "other"
          ]
        },
        "pricing": {
          "type": "string",
          "description": "定价信息（如 $0.01/1K tokens, 按月订阅, 联系销售）"
        },
        "rate_limit": {
          "type": "string",
          "description": "速率限制（如 60 RPM, 100K TPM）"
        },
        "auth_method": {
          "type": "string",
          "description": "认证方式（如 API Key, OAuth2, 企业认证）"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "description": "核心能力列表",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "description": "标签（用于搜索和分类）",
      "items": {
        "type": "string"
      }
    },
    "access": {
      "type": "array",
      "description": "使用方式（可多选，如一个模型同时开放权重并提供 API）",
      "items": {
        "type": "string",
        "enum": [
          "api",
          "saas",
          "private-deployment",
          "open-weights",
          "internal-only",
          "unknown"
        ]
      }
    },
    "references": {
      "type": "array",
      "description": "参考链接（论文、官网、技术博客等）",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "minItems": 1
    }
  }
}