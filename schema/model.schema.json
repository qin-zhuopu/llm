{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vertical Industry LLM Model",
  "description": "Schema for vertical industry closed-source LLM entries, aligned with HuggingFace model card metadata where applicable",
  "type": "object",
  "required": ["name", "company", "domain", "status", "description", "capabilities", "references"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "模型名称",
      "minLength": 1
    },
    "name_en": {
      "type": "string",
      "description": "模型英文名称（如果主名称是中文）"
    },
    "company": {
      "type": "string",
      "description": "开发公司",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "description": "所属垂直领域",
      "enum": [
        "finance",
        "healthcare",
        "legal",
        "retail-ecommerce",
        "education",
        "automotive",
        "pharma-biotech",
        "manufacturing",
        "telecom",
        "energy",
        "government",
        "construction-realestate",
        "media-entertainment",
        "logistics-supplychain",
        "agriculture",
        "materials-science",
        "climate-environment",
        "aerospace-defense",
        "human-resources",
        "accounting-audit"
      ]
    },
    "status": {
      "type": "string",
      "description": "模型状态",
      "enum": ["released", "internal", "research", "deprecated"]
    },
    "release_date": {
      "type": "string",
      "description": "发布日期 (YYYY 或 YYYY-MM 或 YYYY-MM-DD)",
      "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
    },
    "website": {
      "type": "string",
      "description": "官方网站URL",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "description": "模型简介",
      "minLength": 10
    },
    "capabilities": {
      "type": "array",
      "description": "核心能力列表",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "description": "标签（同 HuggingFace tags 字段，自由标签用于搜索和分类）",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "string",
      "description": "参数量（如 50B, 175B, 未公开）"
    },
    "access": {
      "type": "string",
      "description": "使用方式",
      "enum": ["api", "saas", "private-deployment", "internal-only", "unknown"]
    },
    "region": {
      "type": "array",
      "description": "主要服务地区",
      "items": {
        "type": "string",
        "enum": ["global", "china", "us", "europe", "japan", "korea", "southeast-asia", "middle-east"]
      }
    },
    "language": {
      "type": "array",
      "description": "模型支持的语言，使用 ISO 639-1 代码（同 HuggingFace language 字段）",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$"
      }
    },
    "license": {
      "type": "string",
      "description": "许可证标识符（同 HuggingFace license 字段），闭源模型通常为 proprietary 或 other",
      "enum": [
        "proprietary",
        "other",
        "unknown",
        "apache-2.0",
        "mit",
        "gpl-3.0",
        "cc-by-4.0",
        "cc-by-nc-4.0",
        "cc-by-sa-4.0",
        "cc-by-nc-sa-4.0",
        "cc-by-nc-nd-4.0",
        "llama2",
        "llama3",
        "llama3.1",
        "llama3.2",
        "llama3.3",
        "llama4",
        "openrail",
        "bigscience-openrail-m",
        "bigcode-openrail-m",
        "deepfloyd-if-license",
        "gemma"
      ]
    },
    "license_name": {
      "type": "string",
      "description": "自定义许可证名称（当 license 为 other 时使用，同 HuggingFace license_name 字段）"
    },
    "license_link": {
      "type": "string",
      "description": "许可证链接（当 license 为 other 时使用，同 HuggingFace license_link 字段）",
      "format": "uri"
    },
    "pipeline_tag": {
      "type": "string",
      "description": "模型任务类型（同 HuggingFace pipeline_tag 字段，表示模型主要用途）",
      "enum": [
        "text-generation",
        "text-classification",
        "token-classification",
        "question-answering",
        "summarization",
        "translation",
        "fill-mask",
        "feature-extraction",
        "sentence-similarity",
        "text-ranking",
        "image-classification",
        "image-segmentation",
        "object-detection",
        "image-to-text",
        "image-text-to-text",
        "text-to-image",
        "text-to-speech",
        "automatic-speech-recognition",
        "audio-classification",
        "audio-to-audio",
        "audio-text-to-text",
        "text-to-video",
        "image-to-video",
        "video-text-to-text",
        "document-question-answering",
        "visual-question-answering",
        "zero-shot-classification",
        "reinforcement-learning",
        "any-to-any",
        "other"
      ]
    },
    "base_model": {
      "description": "基座模型（同 HuggingFace base_model 字段），可以是单个模型标识符或列表",
      "oneOf": [
        {
          "type": "string",
          "description": "单个基座模型标识符（如 meta-llama/Llama-2-70b 或通用描述如 GPT-4）"
        },
        {
          "type": "array",
          "description": "多个基座模型（用于 merge 场景）",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "datasets": {
      "type": "array",
      "description": "训练数据集（同 HuggingFace datasets 字段），可以是 HF dataset id 或自由描述",
      "items": {
        "type": "string"
      }
    },
    "model_index": {
      "type": "array",
      "description": "结构化评测结果（对齐 HuggingFace model-index 字段）",
      "items": {
        "type": "object",
        "required": ["task", "metrics"],
        "properties": {
          "task": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "description": "任务类型（如 text-generation, question-answering）"
              },
              "name": {
                "type": "string",
                "description": "任务名称"
              }
            }
          },
          "dataset": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "数据集标识符"
              },
              "name": {
                "type": "string",
                "description": "数据集名称"
              },
              "split": {
                "type": "string",
                "description": "数据集分割（如 test, validation）"
              }
            }
          },
          "metrics": {
            "type": "array",
            "description": "评测指标列表",
            "items": {
              "type": "object",
              "required": ["type", "value"],
              "properties": {
                "type": {
                  "type": "string",
                  "description": "指标类型（如 accuracy, f1, bleu）"
                },
                "value": {
                  "description": "指标数值",
                  "oneOf": [
                    { "type": "number" },
                    { "type": "string" }
                  ]
                },
                "name": {
                  "type": "string",
                  "description": "指标名称"
                }
              }
            },
            "minItems": 1
          },
          "source": {
            "type": "object",
            "description": "评测结果来源",
            "properties": {
              "name": {
                "type": "string",
                "description": "来源名称"
              },
              "url": {
                "type": "string",
                "description": "来源链接",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "co2_eq_emissions": {
      "type": "object",
      "description": "碳排放信息（同 HuggingFace co2_eq_emissions 字段）",
      "properties": {
        "emissions": {
          "type": "number",
          "description": "碳排放量（克 CO2）"
        },
        "source": {
          "type": "string",
          "description": "数据来源"
        },
        "training_type": {
          "type": "string",
          "description": "训练类型",
          "enum": ["pre-training", "fine-tuning"]
        },
        "geographical_location": {
          "type": "string",
          "description": "训练地点"
        },
        "hardware_used": {
          "type": "string",
          "description": "使用的硬件"
        }
      }
    },
    "references": {
      "type": "array",
      "description": "参考链接",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      },
      "minItems": 1
    }
  }
}
